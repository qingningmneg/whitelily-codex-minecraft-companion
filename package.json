{
  "name": "whitelily-codex-minecraft-companion",
  "version": "0.2.0-beta.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "build:desktop-child": "node scripts/build-desktop-child.mjs",
    "build:desktop-dev-workspace": "node scripts/prepare-development-codex-workspace.mjs",
    "desktop:dev": "npm run dev --workspace @whitelily/desktop",
    "desktop:build": "npm run build --workspace @whitelily/desktop",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-electron-bundle.ps1",
    "desktop:package:builder": "node ./node_modules/electron-builder/cli.js --projectDir ./apps/desktop --win nsis --x64 --publish never",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-installer.ps1",
    "desktop:inspect-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/inspect-installer.ps1",
    "desktop:test-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-installer.ps1",
    "desktop:test": "npm run test --workspace @whitelily/desktop",
    "minecraft-components:prepare": "subprojects\\whitelily-avatar\\gradlew.bat -p subprojects\\whitelily-avatar :stageMinecraftComponents --no-daemon --max-workers=1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "avatar:test": "subprojects\\whitelily-avatar\\gradlew.bat -p subprojects\\whitelily-avatar :mod-fabric:test",
    "avatar:check": "node subprojects/whitelily-avatar/tools/validate-assets.mjs && subprojects\\whitelily-avatar\\gradlew.bat -p subprojects\\whitelily-avatar :mod-fabric:check",
    "avatar:anime:build": "node subprojects/whitelily-avatar/tools/build-anime-avatar.mjs --export --render-previews",
    "avatar:anime:check": "node subprojects/whitelily-avatar/tools/build-anime-avatar.mjs --verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex": "0.145.0",
    "archiver": "8.0.0",
    "express": "5.2.1",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "es-module-lexer": "2.3.1",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "uuid": "11.1.1"
  }
}
